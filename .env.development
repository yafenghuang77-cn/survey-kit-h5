# 配置文档参考 https://taro-docs.jd.com/docs/next/env-mode-config
# TARO_APP_ID="开发环境下的小程序 AppID"
TARO_APP_ENV=development
TARO_APP_PUBLIC_PATH=/
TARO_APP_API_BASE_URL=/api
TARO_APP_WEAPP_API_BASE_URL=
TARO_APP_DEV_HOST=0.0.0.0
TARO_APP_DEV_PORT=10086
# 在 .env.development.local 中填写真实目标；代理保留 /api 前缀。
TARO_APP_API_PROXY_TARGET=
