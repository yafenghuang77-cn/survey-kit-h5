{
  "name": "survey-kit-h5",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Less",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "build:weapp": "taro build --type weapp --mode production",
    "dev:weapp": "taro build --type weapp --watch --mode development",
    "build:h5": "taro build --type h5 --mode production",
    "dev:h5": "taro build --type h5 --watch --mode development",
    "dev": "taro build --type h5 --watch --mode development",
    "start": "taro build --type h5 --watch --mode development",
    "build": "taro build --type h5 --mode production",
    "typecheck": "tsc --noEmit",
    "lint:script": "eslint src config types --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.{css,less}\" --max-warnings=0",
    "lint": "npm run lint:script && npm run lint:style",
    "lint:fix": "npm run lint:script -- --fix && npm run lint:style -- --fix",
    "check": "npm run typecheck && npm run lint",
    "dev:h5:test": "taro build --type h5 --watch --mode test",
    "build:h5:test": "taro build --type h5 --mode test",
    "dev:weapp:test": "taro build --type weapp --watch --mode test",
    "build:weapp:test": "taro build --type weapp --mode test",
    "dev:test": "taro build --type h5 --watch --mode test",
    "build:test": "taro build --type h5 --mode test"
  },
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-alipay": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-harmony-hybrid": "4.3.0",
    "@tarojs/plugin-platform-jd": "4.3.0",
    "@tarojs/plugin-platform-qq": "4.3.0",
    "@tarojs/plugin-platform-swan": "4.3.0",
    "@tarojs/plugin-platform-tt": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-generator": "4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/minimatch": "^5",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.3.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "postcss-less": "^6.0.0",
    "react-refresh": "^0.14.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12.0",
    "yarn": ">=1.22.22 <2"
  }
}
